{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Observation (Finding) Lifecycle",
    "quality_profile": "showcase",
    "output": "docs/architecture/observation-lifecycle.html"
  },
  "lanes": [
    { "id": "main", "label": "Finding" },
    { "id": "terminal", "label": "Compliance" }
  ],
  "states": [
    { "id": "draft", "type": "start", "label": "DRAFT", "sublabel": "5C format", "lane": "main", "col": 0 },
    { "id": "submitted", "type": "active", "label": "SUBMITTED", "lane": "main", "col": 1 },
    { "id": "reviewed", "type": "decision", "label": "REVIEWED", "sublabel": "manager, not author", "lane": "main", "col": 2 },
    { "id": "issued", "type": "active", "label": "ISSUED", "sublabel": "compliance item created", "lane": "main", "col": 3 },
    { "id": "response", "type": "waiting", "label": "RESPONSE", "sublabel": "auditee responds", "lane": "main", "col": 4 },
    { "id": "compliance", "type": "active", "label": "COMPLIANCE", "lane": "terminal", "col": 1 },
    { "id": "closed", "type": "success", "label": "CLOSED", "sublabel": "HIGH/CRITICAL needs CAE", "lane": "terminal", "col": 2 }
  ],
  "transitions": [
    { "id": "draft-submitted", "from": "draft", "to": "submitted", "route": "straight" },
    { "id": "submitted-reviewed", "from": "submitted", "to": "reviewed", "variant": "emphasis", "route": "straight" },
    { "id": "reviewed-issued", "from": "reviewed", "to": "issued", "route": "straight" },
    { "id": "issued-response", "from": "issued", "to": "response", "route": "straight" },
    { "id": "response-compliance", "from": "response", "to": "compliance" },
    { "id": "compliance-closed", "from": "compliance", "to": "closed", "variant": "security", "route": "straight" }
  ],
  "cards": [
    { "dot": "violet", "title": "Maker-checker", "items": ["The distinctness rule differs per edge, not one blanket rule", "Only 3 of the 6 forward edges (not all shown) require the checker to differ from the maker"] },
    { "dot": "rose", "title": "Severity guard", "items": ["COMPLIANCE -> CLOSED needs CAE specifically for HIGH/CRITICAL severity", "AUDIT_MANAGER or CAE can close LOW/MEDIUM"] },
    { "dot": "cyan", "title": "Not shown", "items": ["Two return transitions also exist: SUBMITTED -> DRAFT and REVIEWED -> SUBMITTED, omitted here for clarity"] }
  ]
}
