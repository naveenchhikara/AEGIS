{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Investments Quarterly Cycle",
    "quality_profile": "showcase",
    "output": "docs/architecture/investments.html"
  },
  "lanes": [{ "id": "main", "label": "Investments" }],
  "mainPath": ["portfolio", "sgl", "broker", "nonslr", "checklist", "cert"],
  "nodes": [
    { "id": "portfolio", "lane": "main", "col": 0, "type": "frontend", "label": "Portfolio", "width": 175 },
    { "id": "sgl", "lane": "main", "col": 1, "type": "backend", "label": "SGL/CSGL Reconciliation", "width": 175 },
    { "id": "broker", "lane": "main", "col": 2, "type": "backend", "label": "Broker Analytics", "width": 175 },
    { "id": "nonslr", "lane": "main", "col": 3, "type": "security", "label": "Non-SLR Cap Monitor", "width": 175 },
    { "id": "checklist", "lane": "main", "col": 4, "type": "frontend", "label": "Classification Checklist", "width": 175 },
    { "id": "cert", "lane": "main", "col": 5, "type": "database", "label": "Quarterly Certification", "width": 175 }
  ],
  "edges": [
    { "id": "portfolio-sgl", "from": "portfolio", "to": "sgl" },
    { "id": "sgl-broker", "from": "sgl", "to": "broker" },
    { "id": "broker-nonslr", "from": "broker", "to": "nonslr", "variant": "security" },
    { "id": "nonslr-checklist", "from": "nonslr", "to": "checklist" },
    { "id": "checklist-cert", "from": "checklist", "to": "cert", "variant": "emphasis" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Gate", "items": ["risk_mis:read"] }
  ]
}
